# Example only: the application does not load this file automatically.
# Set these variables in the shell or service environment before startup.
# PowerShell example: $env:PREPROCESS_API_MODEL = 'YOUR_MODEL'
# API and CLI share these defaults; the web form loads them from the API.
PREPROCESS_API_BASE_URL=https://api.openai.com/v1
PREPROCESS_API_MODEL=YOUR_MODEL
PREPROCESS_REASONING_EFFORT=xhigh
# Optional: blank infers Responses from a /responses endpoint, otherwise Chat.
PREPROCESS_API_PROTOCOL=
# Name of the credential variable for the configured endpoint; never its value.
PREPROCESS_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=YOUR_API_KEY
# Nimabo endpoints retain their isolated credential variable.
# NIMABO_API_KEY=YOUR_NIMABO_API_KEY

# Paths may be absolute; default directories are relative to the project root.
# PREPROCESS_DATA_DIR=C:/path/to/data
# PREPROCESS_OUTPUT_DIR=C:/path/to/output
PREPROCESS_SKILL_OUTPUT_LANGUAGE=English
PREPROCESS_T5_PROCESSING_MODE=agent_architect
# HTML-only acquisition switch; legacy preserves the established HTML route.
# model_guided asks the configured model to select content regions and observed
# links before Python acquires and normalizes them. PDF handling is unchanged.
PREPROCESS_HTML_PROCESSING_MODE=legacy
PREPROCESS_HTML_GUIDED_MAX_ROUNDS=3
PREPROCESS_HTML_GUIDED_LINK_BATCH_SIZE=80
PREPROCESS_HTML_GUIDED_FETCH_CONCURRENCY=4
PREPROCESS_HTML_GUIDED_PLANNER_TRANSPORT=direct
PREPROCESS_HTML_GUIDED_PLANNER_REASONING_EFFORT=none
PREPROCESS_HTML_GUIDED_REVIEW_REASONING_EFFORT=low
# Existing PREPROCESS_MAX_HTML_PAGES bounds acquired children in either route.
# Development feature switch: 0 skips chapter preview/selection and processes
# the complete manual. Set to 1 and restart the backend to enable selection.
PREPROCESS_SCOPE_SELECTION_ENABLED=0

# Optional Reference layout pass. Default preserves the existing source entries.
# agent_formatted adds an Agent layout plan over immutable source-backed units.
PREPROCESS_REFERENCE_FORMATTING_MODE=source_preserved

# Optional independent retrieval configuration. Defaults reuse the form's endpoint,
# model and credential, with bounded protocol negotiation on that same endpoint.
# No model-name or hostname rules select the search protocol.
# PREPROCESS_SEARCH_PROTOCOL=auto
# Allowed: auto, responses, messages, chat_completions.
# PREPROCESS_SEARCH_BASE_URL=https://your-search-provider.example/v1
# PREPROCESS_SEARCH_MODEL=YOUR_SEARCH_MODEL
# PREPROCESS_SEARCH_API_KEY_ENV=SEARCH_API_KEY
# SEARCH_API_KEY=YOUR_SEARCH_API_KEY
# A different search origin requires its own explicit credential variable.
# PREPROCESS_DISCOVERY_TIMEOUT=600

# Backend-only HTTP diagnostics, captured before model protocol adaptation.
# Bodies are UTF-8 text with credentials redacted; no request headers are saved.
PREPROCESS_HTTP_TRACE=1
PREPROCESS_HTTP_TRACE_MAX_RESPONSE_BYTES=33554432
PREPROCESS_HTTP_TRACE_MAX_SESSION_BYTES=268435456
